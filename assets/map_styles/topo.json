        "hillshade-shadow-color": "#2b2b2b"
      }
    },
    {
      "id": "contours",
      "type": "line",
      "source": "cairn-contours",
      "filter": [
        "!=",
        [
          "get",
          "i"
        ],
        1
      ],
      "layout": {
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9C7A4C",
        "line-opacity": 0.5,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.6,
          15,
          0.9,
          17,
          1.3
        ]
      }
    },
    {
      "id": "contours-index",
      "type": "line",
      "source": "cairn-contours",
      "filter": [
        "==",
        [
          "get",
          "i"
        ],
        1
      ],
      "layout": {
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8A5F2E",
        "line-opacity": 0.75,
