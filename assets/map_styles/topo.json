        "symbol-spacing": 280,
        "text-field": [
          "get",
          "l"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-max-angle": 40,
        "text-padding": 2,
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport"
