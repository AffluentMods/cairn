# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cairn: secrets and release artifacts never enter the public repo (spec 12.6)
*.jks
*.keystore
key.properties
debug-symbols/
.env
.env.*
!.env.example
# The pub lockfile IS committed for the app (spec 9.5).
!pubspec.lock


# Design canvas: keep the .dc.html sources + canvas.json, not the seeded payload (~2MB)
design/cairn-screens.html
